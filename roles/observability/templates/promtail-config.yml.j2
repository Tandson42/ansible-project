server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  # Coleta logs de todos os containers Docker via labels
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      # Usa o nome do container como label "job"
      - source_labels: [__meta_docker_container_name]
        regex: '/(.*)'
        target_label: job
      # Adiciona label com a imagem usada
      - source_labels: [__meta_docker_container_image]
        target_label: image
      # Adiciona label com o ID curto do container
      - source_labels: [__meta_docker_container_id]
        regex: '(.{12}).*'
        target_label: container_id
